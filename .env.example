# Configure estas variáveis no ambiente do servidor PHP.
# Este arquivo é um modelo; o PHP não carrega arquivos .env automaticamente.
SMTP_HOST=smtp.titan.email
SMTP_PORT=587
SMTP_USERNAME=seu-email@exemplo.com
SMTP_PASSWORD=preencha-no-servidor
SMTP_FROM=seu-email@exemplo.com
SMTP_TO=secretaria@exemplo.com
